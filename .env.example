# AI 求职陪伴 · LLM 配置示例
# 复制为 .env 后填写 Key（不要提交真实 Key）

# 关闭规则强制，启用外接 LLM
COACH_FORCE_RULES=0

# ---------- 方案 A：通义千问（推荐中文主路径）----------
# 控制台申请 Key：https://bailian.console.aliyun.com/
COACH_LLM_PROVIDER=qwen
COACH_LLM_API_KEY=sk-替换为你的百炼APIKey
# 可选：不设则默认 qwen-plus
# COACH_LLM_MODEL=qwen-plus
# 也可用：qwen-max / qwen3.7-plus
# 也可只设 DASHSCOPE_API_KEY=sk-xxx（与上面二选一即可）

# ---------- 方案 B：DeepSeek（推荐推理/成本敏感）----------
# 控制台申请 Key：https://platform.deepseek.com/
# COACH_LLM_PROVIDER=deepseek
# COACH_LLM_API_KEY=sk-替换为你的DeepSeekAPIKey
# 默认模型 deepseek-v4-flash；更强可用：
# COACH_LLM_MODEL=deepseek-v4-pro
# 也可只设 DEEPSEEK_API_KEY=sk-xxx

# ---------- 可选：主备双路由 ----------
# 主用 Qwen，失败时切 DeepSeek：
# COACH_LLM_PROVIDER=qwen
# COACH_LLM_API_KEY=sk-qwen-xxx
# COACH_LLM_FALLBACK_PROVIDER=deepseek
# COACH_LLM_FALLBACK_API_KEY=sk-deepseek-xxx

# ---------- 可选覆盖 ----------
# COACH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# COACH_ADMIN_TOKEN=本地管理写入知识库口令
