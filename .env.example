# AI 求职陪伴 · 双厂商一起调用（Qwen + DeepSeek）
# 1) 复制本文件为项目根目录 .env
# 2) 填入两家 API Key
# 3) 重启：python -m app.main --mode coach --port 8787
# 4) 登录后 POST /v1/llm/ping 验证

COACH_FORCE_RULES=0
COACH_LLM_MODE=dual

# 主路径：通义千问（中文表达 / 简历 / 面试）
# 申请：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-请替换为百炼APIKey
COACH_LLM_PROVIDER=qwen
COACH_LLM_MODEL=qwen-plus

# 备用 + 推理分流：DeepSeek（匹配 / 准备度；主失败时自动顶上）
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-请替换为DeepSeekAPIKey
COACH_LLM_FALLBACK_PROVIDER=deepseek
COACH_LLM_FALLBACK_MODEL=deepseek-v4-flash

# 可选：自定义任务分流（JSON）
# COACH_LLM_TASK_ROUTES={"resume.suggest":"qwen","match.explain":"deepseek","readiness.assess":"deepseek"}
